# Copy to .env. If ANTHROPIC_API_KEY / GEMINI_API_KEY are unset, the lab reads them from ../backend/.env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Arm C generator (the new pipeline) and the blind judge
BBL_GEN_MODEL=claude-opus-5-5
BBL_JUDGE_MODEL=claude-opus-5-5
# Optional second judge from another model family (reduces self-preference bias); empty = off
BBL_XJUDGE_MODEL=gemini-3.6-flash|gemini-3.5-flash-lite
# Arms A/B reproduce today's JIL behaviour on the backend's current model
BBL_BASELINE_MODEL=claude-sonnet-5-5

BBL_GEN_EFFORT=medium
BBL_JUDGE_EFFORT=high
BBL_MAX_REPAIRS=2
BBL_FALLBACKS=1

# Native-ear reviewer in the review team (arm D); a "|" list is tried in order, then Claude
BBL_NATIVE_EAR_MODEL=gemini-3.6-flash|gemini-3.5-flash-lite
# Optional pooled-key proxy for Gemini (rotates keys on 429). Leave empty to call Gemini directly.
ACN_TOKEN=
BBL_GEMINI_BASE_URL=https://key.sidharth.co/proxy/gemini
